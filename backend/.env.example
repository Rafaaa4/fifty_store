PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# PostgreSQL
DATABASE_URL=postgres://postgres:root@localhost:5432/fifty_store
# If you use docker compose from this folder, use:
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/fifty_store
# Or use PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD instead of DATABASE_URL.

# Change this in production.
JWT_SECRET=replace-with-a-long-random-secret

# First admin is created on startup if it does not exist.
ADMIN_EMAIL=admin@fiftystore.tn
ADMIN_PASSWORD=change-this-password
